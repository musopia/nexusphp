# NexusPHP 环境变量说明（每项配置的解释在其上一行）。
# 开发部署：将 .env.dev 复制为 .env 后运行 docker compose up -d --build。
# 仅使用 --env-file 不会改变应用读取项目根目录 .env 的行为。
# 第三方存储、搜索、验证码、翻译等服务均为可选，当前 Compose 不会自动部署这些服务。
# 注释标记“不使用则留空”的变量无需为启动网站而申请账号；密码及密钥不要公开。

# 站点/应用名称，也用作默认邮件发件人名称；开发环境可自行命名。
APP_NAME=Musopia-Test

# 运行环境；开发通常用 local，生产用 production。部分功能会严格判断是否为 production。
APP_ENV=dev

# 应用加密密钥，必须填写；.env.dev 已生成可用值，不需重生成。已有数据时保留原密钥，变更会影响加密数据及登录状态。
APP_KEY=base64:WUbN2wa2kl3E1VDW4iKaH3RBHw3hKY7BK0hWEkBZmGg=

# 是否显示详细异常；开发可为 true，公网或生产建议 false，避免错误页面显示内部信息。
APP_DEBUG=true

# 网站完整访问地址（含协议、非默认端口）；用于生成链接。更换域名/IP/端口后修改此项。
APP_URL=http://108.186.129.34

# Laravel 日志通道：stack 为组合通道，stderr 输出到标准错误；PHP Docker 镜像设置了 LOG_CHANNEL=stderr，容器环境可能优先于此值。
LOG_CHANNEL=stack

# 最低日志级别；info 记录一般运行信息及 warning/error 等，不记录 debug。当前开发要求保留 info。
LOG_LEVEL=info

# 数据库类型；本 Compose 使用 mysql，保持不变。
DB_CONNECTION=mysql

# 数据库连接地址；本 Compose 使用 host.docker.internal，通过 extra_hosts 指向宿主机网关。
DB_HOST=host.docker.internal

# 连接宿主机上的 MySQL 映射端口，默认 13306；容器内 MySQL 仍监听 3306。端口冲突时修改此项。
DB_PORT=13306

# 数据库名称；数据目录为空时由 MySQL 首次初始化创建。已有数据时需与实际数据库一致。
DB_DATABASE=nexusphp

# 应用连接 MySQL 的用户名，不是网站管理员；首次初始化创建此非 root 用户。
DB_USERNAME=nexusphp

# 数据库密码，必填；Compose 同时将其作为 root 和应用用户初始密码。开发文件已生成；已有数据库改此项不会自动改账户密码。
DB_PASSWORD=nexusphp

# PostgreSQL 的 schema（命名空间），通常为 public；当前使用 MySQL，不生效，保留即可。
DB_SCHEMA=public

# 实时事件广播驱动；log 仅写日志，不连接推送服务。开发保留 log；使用 Pusher 时才调整。
BROADCAST_DRIVER=log

# 通用缓存驱动变量；当前 config/cache.php 将默认缓存固定为 redis，此项不会切换驱动，保留即可。
CACHE_DRIVER=redis

# 后台任务队列驱动；保留 redis，由 Compose 的 queue 服务消费任务。
QUEUE_CONNECTION=redis

# 登录会话存储驱动变量；当前 config/session.php 固定使用 redis，此项不会切换实际驱动。
SESSION_DRIVER=file

# Laravel 会话有效时间，单位分钟；120 表示两小时，开发通常不用修改。
SESSION_LIFETIME=120

# 可选 Memcached 缓存服务器地址；当前默认缓存用 Redis，Compose 未提供 Memcached，保留即可。
MEMCACHED_HOST=127.0.0.1

# 邮件驱动；log 把邮件内容写日志而不发送，smtp 实际发送邮件。开发不测试邮件投递时用 log。
MAIL_MAILER=smtp

# 仅 SMTP 发送时需要：邮件服务器地址；mailhog 是示例，当前 Compose 未提供它。宿主机邮件服务可填 host.docker.internal。
MAIL_HOST=mailhog

# 仅 SMTP 时需要：服务器端口，常见 587（TLS）、465（SSL），以邮件服务商要求为准。
MAIL_PORT=1025

# 仅 SMTP 时需要：登录账号，通常为邮箱地址；log 驱动忽略。
MAIL_USERNAME=null

# 仅 SMTP 时需要：密码或授权码；log 驱动忽略。
MAIL_PASSWORD=null

# 仅 SMTP 时需要：tls、ssl 或 null，按邮件服务器要求填写。
MAIL_ENCRYPTION=null

# 发件人邮箱；真实发送时填写邮件服务商允许的地址。开发不发送可保留。
MAIL_FROM_ADDRESS=null

# 收件人看到的发件人名称；默认引用 APP_NAME，通常不用修改。
MAIL_FROM_NAME="${APP_NAME}"

# 可选 Amazon S3 对象存储访问 ID；使用 S3 文件存储时填写，不用 S3 则留空。
AWS_ACCESS_KEY_ID=

# 可选 S3 访问密钥，与上面的访问 ID 配套；不用 S3 留空，不要提交真实密钥。
AWS_SECRET_ACCESS_KEY=

# S3 所在区域，如 us-east-1；仅使用 S3 时按存储桶区域修改。
AWS_DEFAULT_REGION=us-east-1

# S3 存储桶名称；仅使用 S3 时填写。填写凭证本身不会自动把本地文件迁移到 S3。
AWS_BUCKET=

# 可选 Pusher 实时消息应用 ID；仅启用 Pusher 广播时填写，开发 log 广播不需要。
PUSHER_APP_ID=

# Pusher 应用公开 key；仅使用 Pusher 时填写。
PUSHER_APP_KEY=

# Pusher 服务端签名密钥；仅使用 Pusher 时填写，不向前端公开。
PUSHER_APP_SECRET=

# Pusher 应用所在集群；使用 Pusher 时与其控制台一致，否则保留默认。
PUSHER_APP_CLUSTER=mt1

# 前端构建使用的 Pusher 公开 key，默认引用 PUSHER_APP_KEY；不用 Pusher 无需修改。
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"

# 前端构建使用的 Pusher 集群，默认引用 PUSHER_APP_CLUSTER；不用 Pusher 无需修改。
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Redis 地址；本 Compose 使用 host.docker.internal，经宿主机映射端口连接。
REDIS_HOST=host.docker.internal

# 必填，Compose 同时用于 Redis 服务端认证和应用连接；开发文件已生成可用密码。
REDIS_PASSWORD=

# 宿主机 Redis 映射端口，默认 16379；容器内 Redis 仍监听 6379，端口冲突时修改。
REDIS_PORT=16379

# Redis 默认逻辑数据库编号，保留 0；项目缓存默认使用 1，会话使用 10，不必手动创建。
REDIS_DB=0

# 旧版定时清理开关；当前仓库未找到对此变量的读取。Compose 的 cleanup 服务会独立循环运行清理，不能靠此项停用。
USE_CRON_TRIGGER_CLEANUP=true

# 项目自有日志输出位置；Compose 建议 php://stdout，可用 docker compose logs 查看。它与 Laravel 的 LOG_CHANNEL 是两套配置。
LOG_FILE=/tmp/nexus.log

# 应用时区；中国时间可填 Asia/Shanghai 或 PRC，影响日志和定时任务时间。
TIMEZONE=PRC

# 可选 Google Drive 存储 OAuth 客户端 ID；启用 Google Drive 文件存储/备份时填写，否则留空。
GOOGLE_DRIVE_CLIENT_ID=

# Google Drive OAuth 客户端密钥，与客户端 ID 配套；不使用则留空。
GOOGLE_DRIVE_CLIENT_SECRET=

# Google Drive OAuth 刷新令牌，用于持续访问授权账户；不使用则留空。
GOOGLE_DRIVE_REFRESH_TOKEN=

# Google Drive 目标文件夹 ID，不是文件夹名称或本地路径；不使用则留空。
GOOGLE_DRIVE_FOLDER_ID=

# 可选 GeoIP2 地理位置 .mmdb 数据库文件的容器内路径；用于查询 IP 地理信息，未准备数据库文件时留空。
GEOIP2_DATABASE=

# 可选 GeoIP2 ASN .mmdb 文件的容器内路径；用于 IP 所属网络/ASN 查询及盒子相关识别，未准备时留空。
GEOIP2_ASN_DATABASE=

# 可选 Elasticsearch 搜索服务器地址；Compose 未提供该服务，不使用则留空，宿主机服务可填 host.docker.internal。
ELASTICSEARCH_HOST=

# Elasticsearch HTTP API 端口，常见 9200；仅启用该搜索服务时填写。
ELASTICSEARCH_PORT=

# Elasticsearch 连接协议 http 或 https；按服务实际配置填写，不使用则留空。
ELASTICSEARCH_SCHEME=

# Elasticsearch 认证用户名；按服务实际账号填写，不使用则留空。
ELASTICSEARCH_USER=

# Elasticsearch 认证密码；不使用则留空。
ELASTICSEARCH_PASS=

# Elasticsearch TLS 证书校验设置，支持形式取决于客户端；代码仅在非空时传入，不用该服务时留空，不建议随意关闭校验。
ELASTICSEARCH_SSL_VERIFICATION=

# 是否启用 Elasticsearch 搜索；不使用时留空，启用时填 1 并配置上面的连接参数及索引。
ELASTICSEARCH_ENABLED=

# 可选 SFTP 远程文件存储服务器地址；用于配置 SFTP 存储/备份，不使用则留空。
SFTP_HOST=

# SFTP 登录用户名；不使用则留空。
SFTP_USERNAME=

# SFTP 登录密码；不使用则留空。需要私钥认证时还需配置 SFTP_PRIVATE_KEY，当前模板未列出。
SFTP_PASSWORD=

# SFTP SSH 端口，启用时通常填 22；不使用则留空。
SFTP_PORT=

# SFTP 远程服务器上的根目录，不是本站宿主机数据目录；启用时建议改为长期存储目录。
SFTP_ROOT=/tmp

# 新建 users 表时的用户 ID 自增起点，默认 10001；仅初始化时有用，不会修改已有用户 ID。
UID_STARTS=10001

# 执行 Artisan 子命令的 PHP 可执行文件路径；留空使用 PATH 中的 php，当前 Docker 环境无需填写。
PHP_PATH=

# 可选 NAS-Tools 对接认证密钥；对接时按双方约定填写，不使用则留空。
NAS_TOOLS_KEY=

# 可选 IYUU 对接认证密钥；对接时填写，不使用则留空。
IYUU_SECRET=

# 可选 AMMDS 对接签名密钥；对接时填写，不使用则留空。
AMMDS_SECRET=

# 可选 Meilisearch 搜索协议，默认 http；Compose 未提供该服务，不用时保留默认即可。
MEILISEARCH_SCHEME=http

# Meilisearch 地址；启用并部署在宿主机时使用 host.docker.internal。127.0.0.1 在容器内指容器自身；不用时无需修改。
MEILISEARCH_HOST=127.0.0.1

# Meilisearch API 端口，默认 7700；仅使用该搜索服务时按实际映射端口修改。
MEILISEARCH_PORT=7700

# 项目 Meilisearch 对接密钥；不使用则留空。配置连接本身不会部署搜索服务或创建索引。
MEILISEARCH_MASTER_KEY=

# BT 客户端允许列表在 Redis 中的缓存键名称；内部约定，保留默认。
CACHE_KEY_AGENT_ALLOW=all_agent_allows

# BT 客户端禁止列表在 Redis 中的缓存键名称；内部约定，保留默认。
CACHE_KEY_AGENT_DENY=all_agent_denies

# 设置变更事件使用的 Redis 发布订阅频道名；内部组件需保持一致，保留默认。
CHANNEL_NAME_SETTING=channel_setting

# 模型数据变更事件使用的 Redis 发布订阅频道名；内部组件需保持一致，保留默认。
CHANNEL_NAME_MODEL_EVENT=channel_model_event

# 强制生成链接使用 http 或 https；留空不强制。当前代码仅 APP_ENV=production 时生效，开发通常留空。
FORCE_SCHEME=

# 验证码类型：image 本地图片、cloudflare_turnstile 或 google_recaptcha_v2；开发用 image，不需第三方密钥。
CAPTCHA_DRIVER=image

# 签到是否需要验证码；true 开启，false 关闭，按开发测试需求选择。
CAPTCHA_ATTENDANCE_ENABLED=true

# Cloudflare Turnstile 网站公开 key；仅验证码类型为 cloudflare_turnstile 时必填。
TURNSTILE_SITE_KEY=

# Cloudflare Turnstile 服务端验证密钥；仅启用该验证码时必填。
TURNSTILE_SECRET_KEY=

# Turnstile 外观：light、dark 或 auto；不用 Turnstile 时保留即可。
TURNSTILE_THEME=light

# Turnstile 尺寸：normal、compact 或 flexible；不用 Turnstile 时保留即可。
TURNSTILE_SIZE=flexible

# Google reCAPTCHA v2 网站公开 key；仅验证码类型为 google_recaptcha_v2 时必填。
RECAPTCHA_SITE_KEY=

# Google reCAPTCHA v2 服务端验证密钥；仅启用该验证码时必填。
RECAPTCHA_SECRET_KEY=

# reCAPTCHA 外观：light 或 dark；不用该验证码时保留即可。
RECAPTCHA_THEME=light

# reCAPTCHA 组件尺寸，通常 normal 或 compact；不用时保留即可。
RECAPTCHA_SIZE=normal

# 可选 Crowdin 翻译平台访问令牌，用于翻译同步；普通开发运行不需要，留空即可。
CROWDIN_ACCESS_TOKEN=

# Crowdin 翻译项目 ID；仅执行翻译平台集成时填写。
CROWDIN_PROJECT_ID=

# 可选 ClickHouse 分析数据库地址；Compose 未提供该服务，普通开发不启用相关功能时留空。
CLICKHOUSE_HOST=

# ClickHouse HTTP API 端口，常见 8123；仅接入 ClickHouse 时填写。
CLICKHOUSE_HTTP_PORT=

# ClickHouse 原生 TCP 端口，常见 9000；当前仓库未找到读取此变量，普通开发留空即可。
CLICKHOUSE_TCP_PORT=

# ClickHouse 登录用户；仅接入该服务时填写。
CLICKHOUSE_USER=

# ClickHouse 用户密码；仅接入该服务时填写。
CLICKHOUSE_PASSWORD=

# ClickHouse 数据库名称；仅接入该服务时填写，不是 MySQL 数据库名。
CLICKHOUSE_DATABASE=

# 宿主机 MySQL 数据目录；相对路径基于 Compose 文件目录。开发保留 ./mysql_data，已有数据改路径前必须迁移。
NP_MYSQL_DATA_PATH=./mysql_data

# 宿主机 Redis 持久化目录；开发保留 ./redis_data。保存 AOF/RDB 数据，不应手动修改内部文件。
NP_REDIS_DATA_PATH=./redis_data

# 宿主机备份文件目录；开发保留 ./backup_data。配置目录不会自动开启应用备份任务。
NP_BACKUP_DATA_PATH=./backup_data

# 容器内备份导出目录，映射到宿主机 NP_BACKUP_DATA_PATH；需与站点后台备份路径一致，保留默认即可。
NP_BACKUP_EXPORT_PATH=/tmp/nexusphp_backup

# 内部服务端口绑定的宿主机网桥 IP；默认 172.17.0.1。用 docker network inspect bridge 核对，需与 host-gateway 一致，不能填 127.0.0.1。
NP_HOST_BIND=172.17.0.1

# PHP-FPM 映射到宿主机网桥的端口；供 OpenResty 通过 host.docker.internal 访问，不是浏览器访问端口，保留 19000。
NP_PHP_PORT=19000

# phpMyAdmin 映射到宿主机网桥的 HTTP 端口；供 OpenResty 转发，通常保留 18081。
NP_PMA_PORT=18081

# 网站域名或 IP，不含 http://、https:// 或端口；应与 APP_URL 的主机部分一致。
NP_DOMAIN=localhost

# 网站对外端口，同时用于 OpenResty 容器监听；开发为 8080，需在 APP_URL 中带上。证书目录含 fullchain.pem 和 private.key 时会改为 HTTPS，需同步调整 APP_URL。
NP_PORT=80
