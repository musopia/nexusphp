# dev 服务器部署配置：随仓库管理，供 .github/workflows/deploy-dev.yml 读取。
# 服务器上的运行环境（APP_KEY / DB_* / REDIS_* / NP_*）仍在服务器 /opt/nexusphp/.env-dev 里，不在这里。
DEPLOY_HOST=108.186.129.34
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_KEY_FILE=deploy/id_rsa_ci
REMOTE_PACKAGE_DIR=/opt/nexusphp-packages
REMOTE_RUNNER=/opt/nexusphp-deploy/deploy.sh
MODE=dev
SYNC_ENV=false
# 首次 auto-install 用；已装好的服务器会跳过。留空则生成随机密码并打印在部署日志里。
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@musopia.vip
ADMIN_PASSWORD=
